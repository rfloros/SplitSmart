@startuml
title Payment Settlement - simplified Architecture B (serialized SQLite writes)

|Payer (Swing view/presenter)|
start
:Choose recipient, enter amount and date;
:Submit (presenter runs use case off the EDT);

|PaymentService (application.service)|
:Resolve trusted current account (payer);
:Validate amount: plain decimal, exact at group scale,
positive, within size limit;

|SQLite UnitOfWork (one connection)|
:BEGIN IMMEDIATE;
:Verify current membership of payer and recipient;
:Derive current net debt payer -> recipient from
approved expense shares and confirmed payments;
if (Valid, distinct parties, correct currency,
amount <= net debt?) then (no)
  :ROLLBACK;
  |Payer (Swing view/presenter)|
  :Show validation/authorization error;
  stop
else (yes)
  :Insert payment as PENDING;
  :COMMIT;
endif

|Payer (Swing view/presenter)|
:Payment shown as PENDING;
note right
  Pending payments have no financial effect.
  Balances are unchanged.
end note

|Recipient (Swing view/presenter)|
:Open pending payments; choose Confirm;
:Submit (off the EDT);

|PaymentService (application.service)|
:Resolve trusted current account (actor);

|SQLite UnitOfWork (one connection)|
:BEGIN IMMEDIATE (before reading anything
used for validation);
if (Database busy/locked?) then (yes)
  :Bounded wait; if still busy, ROLLBACK and
  restart the whole transaction (bounded attempts);
  if (Attempts exhausted?) then (yes)
    |Recipient (Swing view/presenter)|
    :Show "database busy" failure;
    no success indication, no change;
    stop
  else (no)
  endif
else (no)
endif
:Load payment;
if (Actor and both parties are current
group members?) then (no)
  :ROLLBACK;
  |Recipient (Swing view/presenter)|
  :Show denial; no change;
  stop
else (yes)
endif
if (Actor is the recipient?) then (no)
  :ROLLBACK;
  |Recipient (Swing view/presenter)|
  :Show denial; no change;
  stop
else (yes)
endif
if (Payment is PENDING?) then (no)
  :ROLLBACK; return Conflict
  (already confirmed; effect not repeated);
  |Recipient (Swing view/presenter)|
  :Show message;
  stop
else (yes)
endif
:Derive current net debt inside this transaction;
if (Payment amount <= current net debt?) then (no)
  :ROLLBACK; payment stays PENDING;
  |Recipient (Swing view/presenter)|
  :Show validation error
  (e.g. debt 100, two payments of 60:
  second sees remaining 40);
  stop
else (yes)
  :Conditional update PENDING -> CONFIRMED;
  if (Exactly one row changed?) then (no)
    :ROLLBACK; return Conflict;
    |Recipient (Swing view/presenter)|
    :Show message;
    stop
  else (yes)
    :COMMIT;
  endif
endif

|Recipient (Swing view/presenter)|
:Balance views now show the reduced debt
(derived from confirmed payments);
stop
@enduml
