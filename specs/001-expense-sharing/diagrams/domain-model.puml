@startuml
title SplitSmart Domain Model
hide empty members
skinparam classAttributeIconSize 0

class Account {
  accountId
  email
  displayName
  verificationState
}

class Group {
  groupId
  name
  currencyCode
}

class Membership {
  role
  active
  joinedAt
  removedAt
}

class ApprovalPolicy {
  kind
  reviewerIds
}

class Expense {
  expenseId
  date
  description
  splitMethod
  status
  version
}

class ExpenseShare {
  amount: BigDecimal
  percentage: BigDecimal [optional]
  participantOrder
}

class ApprovalDecision {
  result
  decidedAt
  reason [optional]
}

class Payment {
  paymentId
  amount: BigDecimal
  date
  status
  confirmedAt [optional]
}

class Notification {
  notificationId
  createdAt
  readAt [optional]
}

class Money <<value object>> {
  amount: BigDecimal
  currencyCode
  currencyScale
}

class Balance <<read projection>> {
  debtorId
  creditorId
  amount: Money
}

class Report <<read projection>> {
  startDate
  endDate
  totals
}

class Receipt <<stored content>> {
  receiptId
  mediaType
  sizeBytes
  contentHash
  privateStorageKey
}

Group "1" *-- "0..*" Membership
Membership "*" --> "1" Account
Group "1" *-- "1" ApprovalPolicy
ApprovalPolicy "*" --> "*" Membership : authorized reviewers
Group "1" *-- "0..*" Expense
Expense "*" --> "1" Account : submitter
Expense "*" --> "1" Account : payer
Expense "1" *-- "1..*" ExpenseShare
ExpenseShare "*" --> "1" Account : participant
Expense "1" *-- "0..1" ApprovalDecision
ApprovalDecision "*" --> "1" Account : reviewer
Expense "1" o-- "0..1" Receipt
Group "1" *-- "0..*" Payment
Payment "*" --> "1" Account : payer/debtor
Payment "*" --> "1" Account : recipient/creditor
Group "1" *-- "0..*" Notification
Notification "*" --> "1" Account : recipient
Balance ..> ExpenseShare : approved expense obligations
Balance ..> Payment : confirmed settlements
Report ..> Expense
Report ..> Payment
Report ..> Balance
Money .. Expense
Money .. ExpenseShare
Money .. Payment
Money .. Balance

note right of Balance
  Derived from approved expense shares
  and confirmed payments. Not stored as
  an independently mutable balance.
end note
@enduml
